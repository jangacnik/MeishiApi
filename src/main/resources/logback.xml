<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- One JSON object per line with MDC (requestId) and structured fields, like omiyage-api. -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <logger name="tcg.accumulator.meishiapi" level="${LOG_LEVEL:-INFO}"/>
    <logger name="access" level="${LOG_LEVEL:-INFO}"/>
    <logger name="security" level="${LOG_LEVEL:-INFO}"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
